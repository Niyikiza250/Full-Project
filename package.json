{
  "name": "mifem-project",
  "private": true,
  "version": "0.0.0",
  "description": "MIFEM Management Information System - root scripts for the frontend and backend apps",
  "scripts": {
    "install:all": "npm --prefix Frontend_Mifem install && npm --prefix Backend_MIFEM install",
    "dev": "node scripts/dev.js",
    "dev:frontend": "npm --prefix Frontend_Mifem run dev",
    "dev:backend": "npm --prefix Backend_MIFEM run dev",
    "build": "npm --prefix Frontend_Mifem run build",
    "lint": "npm --prefix Frontend_Mifem run lint",
    "typecheck": "npm --prefix Frontend_Mifem run typecheck",
    "test": "npm --prefix Frontend_Mifem run test",
    "preview": "npm --prefix Frontend_Mifem run preview",
    "start:backend": "npm --prefix Backend_MIFEM start",
    "seed": "npm --prefix Backend_MIFEM run seed",
    "seed:sda": "npm --prefix Backend_MIFEM run seed:sda"
  }
}
