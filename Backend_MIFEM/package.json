{
  "name": "backend-mifem",
  "version": "2.0.0",
  "description": "MIFEM Backend API - Full PostgreSQL Integration",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node -e \"require('./config/db').connectDB().then(() => { require('./seeders').seed().then(() => process.exit()) })\"",
    "seed:sda": "node -e \"require('./config/db').connectDB().then(() => { require('./seeders/sdaData').seedSdaData().then(() => process.exit()) })\""
  },
  "keywords": [
    "mifem",
    "church-management",
    "postgresql",
    "sequelize"
  ],
  "author": "MIFEM",
  "license": "ISC",
  "dependencies": {
    "@devrw/rwanda-location": "^1.1.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.11",
    "pg": "^8.13.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
