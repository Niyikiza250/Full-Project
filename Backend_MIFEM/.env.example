PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mifem_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mifem_db
DB_USER=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=mifem_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=30d

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
