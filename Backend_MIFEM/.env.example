PORT=5000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/mifem_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mifem_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT - Use a strong random string (min 32 chars)
JWT_SECRET=generate_a_strong_random_secret_here
JWT_EXPIRES_IN=30d

# CORS - Comma-separated origins for production
CORS_ORIGIN=http://localhost:5173,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=100

# Startup seeding (defaults to enabled in development, disabled in production)
SEED_ON_STARTUP=false

# Admin Account
ADMIN_EMAIL=admin@mifem.org
ADMIN_PASSWORD=change_this_password

# Demo Account Passwords (change for production)
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_USER_PASSWORD=Demo@123

# Achievement migration data directory (optional)
# ACHIEVEMENT_DATA_DIR=../Frontend_MIFEM/public/acchievement/data

# Frontend URL
FRONTEND_URL=http://localhost:5173

# SMTP Email Configuration
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@mifem.org
SMTP_FROM_NAME=MIFEM